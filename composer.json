{
    "name": "codeigniter4/boilerplate-shadui",
    "description": "CodeIgniter 4 Boilerplate with Shadui UI, Authentication, and User Management",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "codeigniter4/framework": "^4.7",
        "firebase/php-jwt": "^7.1",
        "ramsey/uuid": "^4.9",
        "codeigniter4/shield": "^1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "post-install-cmd": [
            "php spark migrate"
        ]
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
